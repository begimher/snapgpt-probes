#!/usr/bin/env python3
import pathlib, subprocess, time, json
out = {'utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), 'cwd': str(pathlib.Path.cwd()), 'tests': []}
for args in (['--vuln-trigger'], []):
    try:
        p = subprocess.run(['./cve-timing', *args], cwd='/tmp/workspace', capture_output=True, text=True, timeout=180)
        out['tests'].append({'args': args, 'rc': p.returncode, 'stdout': p.stdout[-30000:], 'stderr': p.stderr[-10000:]})
    except BaseException as e:
        out['tests'].append({'args': args, 'error': repr(e)})
pathlib.Path('/tmp/workspace/cve-wrapper.out').write_text(json.dumps(out, indent=2))
print(json.dumps(out, separators=(',', ':')))
